#include "imports/stdlib.fc";

;; ============================================================
;; Jetton Airdrop Contract
;;
;; Holds T0H jettons on its jetton-wallet and sends a fixed
;; amount to every user who sends an op::claim message.
;; Owner can set jetton wallet address, withdraw TON/jettons.
;; ============================================================

;; --- Opcodes ---
const int op::claim             = 1;
const int op::set_jetton_wallet = 2;
const int op::withdraw_ton      = 3;
const int op::withdraw_jetton   = 4;
const int op::set_claim_amount  = 5;
const int op::jetton_transfer   = 0x0f8a7ea5;  ;; TEP-74

;; --- Errors ---
const int err::unauthorized   = 401;
const int err::not_configured = 402;

;; --- Gas ---
const int JETTON_FWD_GAS = 80000000;   ;; 0.08 TON forwarded to jetton wallet
const int FORWARD_AMOUNT = 1;          ;; 1 nanoton forward to recipient

;; ===================== Storage =====================
;; cell data = owner:MsgAddr  jetton_wallet:MsgAddr  claim_amount:Coins

(slice, slice, int) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),   ;; owner
        ds~load_msg_addr(),   ;; jetton_wallet (addr_none until set)
        ds~load_coins()       ;; claim_amount in base units
    );
}

() save_data(slice owner, slice jw, int amount) impure inline {
    set_data(
        begin_cell()
            .store_slice(owner)
            .store_slice(jw)
            .store_coins(amount)
        .end_cell()
    );
}

;; ================ Jetton transfer helper ================

() send_jettons(slice jw, int query_id, int amount, slice dest) impure inline {
    cell body = begin_cell()
        .store_uint(op::jetton_transfer, 32)
        .store_uint(query_id, 64)
        .store_coins(amount)
        .store_slice(dest)       ;; destination
        .store_slice(dest)       ;; response_destination (excess TON → user)
        .store_uint(0, 1)        ;; no custom_payload
        .store_coins(FORWARD_AMOUNT)
        .store_uint(0, 1)        ;; no forward_payload
    .end_cell();

    cell msg = begin_cell()
        .store_uint(0x18, 6)             ;; bounceable
        .store_slice(jw)                 ;; to: contract's jetton-wallet
        .store_coins(JETTON_FWD_GAS)     ;; 0.08 TON for gas
        .store_uint(1, 107)              ;; default fields + body as ref
        .store_ref(body)
    .end_cell();

    send_raw_message(msg, 1);  ;; mode 1 = pay fees separately
}

;; ====================== Main ========================

() recv_internal(int balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    ;; Accept simple TON transfers (top-up)
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }  ;; ignore bounced
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (slice owner, slice jw, int claim_amount) = load_data();

    ;; ---- PUBLIC: claim airdrop ----
    if (op == op::claim) {
        ;; Jetton wallet must be configured
        throw_if(err::not_configured, jw.preload_uint(2) == 0);
        send_jettons(jw, query_id, claim_amount, sender);
        return ();
    }

    ;; ---- ADMIN: owner-only operations ----
    throw_unless(err::unauthorized, equal_slice_bits(sender, owner));

    if (op == op::set_jetton_wallet) {
        slice new_jw = in_msg_body~load_msg_addr();
        save_data(owner, new_jw, claim_amount);
        return ();
    }

    if (op == op::set_claim_amount) {
        int new_amount = in_msg_body~load_coins();
        save_data(owner, jw, new_amount);
        return ();
    }

    if (op == op::withdraw_ton) {
        raw_reserve(50000000, 0);  ;; keep 0.05 TON for rent
        cell msg = begin_cell()
            .store_uint(0x10, 6)   ;; non-bounceable
            .store_slice(owner)
            .store_coins(0)
            .store_uint(0, 107)
        .end_cell();
        send_raw_message(msg, 128);  ;; send all except reserve
        return ();
    }

    if (op == op::withdraw_jetton) {
        int amount = in_msg_body~load_coins();
        send_jettons(jw, query_id, amount, owner);
        return ();
    }

    throw(0xffff);
}

;; =================== Get methods ====================

slice get_owner() method_id {
    (slice owner, _, _) = load_data();
    return owner;
}

slice get_jetton_wallet() method_id {
    (_, slice jw, _) = load_data();
    return jw;
}

int get_claim_amount() method_id {
    (_, _, int amount) = load_data();
    return amount;
}
