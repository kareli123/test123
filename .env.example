# TON Jetton Project Environment Variables

# Network: mainnet | testnet
NETWORK=mainnet

# Jetton Master address (USDT on mainnet)
JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1ifCcfL6hPQBfta10

# Amount to claim/send (in base units, e.g. 1000000 = 1 USDT with 6 decimals)
CLAIM_AMOUNT=1000000

# Token decimals (6 for USDT, 9 for TON)
TOKEN_DECIMALS=6

# TonCenter API key (get at https://toncenter.com)
TONCENTER_API_KEY=your_api_key_here

# Deployer wallet mnemonic (for scripts only, keep secret!)
MNEMONIC=word1 word2 word3 ... word24
