# TON Jetton Airdrop Environment Variables

# Network: mainnet | testnet
NETWORK=mainnet

# Jetton Master address for the airdrop token
JETTON_MASTER=EQCtJiXSoQPBRMh2yijkSyTZ1iqkj-uQRKvvaAUlkFLUwsS6

# Amount to claim/send in base units (e.g. 1000000 = 1 token with 6 decimals)
CLAIM_AMOUNT=1000000

# Token display settings
TOKEN_DECIMALS=6
TOKEN_SYMBOL=T0H

# TonCenter API key (get at https://toncenter.com)
TONCENTER_API_KEY=your_api_key_here

# Airdrop sender wallet mnemonic (backend only, keep secret!)
MNEMONIC=sniff always produce visual common wasp bottom infant sauce north rhythm prevent cigar bright dizzy guess black parade erosion brick planet humor side arrest

# Optional backend settings
PORT=3000
CORS_ORIGIN=*
SEQNO_WAIT_ATTEMPTS=20
